---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Notice | Kervox" description="How Kervox handles information submitted through this website.">
  <main class="min-h-screen bg-white px-5 py-16 text-slate-700 md:px-8">
    <article class="mx-auto max-w-3xl">
      <a href="/" class="text-sm font-semibold text-blue-700 hover:underline">← Back to Kervox</a>
      <h1 class="mt-8 text-4xl font-bold text-slate-950">Privacy notice</h1>
      <p class="mt-4 text-sm text-slate-500">Last updated: 17 October 2026</p>
      <div class="mt-10 space-y-8 leading-7">
        <section><h2 class="text-xl font-semibold text-slate-950">Information we collect</h2><p class="mt-2">When you request a demo, we collect the contact and business information you provide, together with basic technical information needed to protect the form from abuse.</p></section>
        <section><h2 class="text-xl font-semibold text-slate-950">How we use it</h2><p class="mt-2">We use this information to respond to your enquiry, arrange a demonstration, understand your requirements, and maintain a record of our communication.</p></section>
        <section><h2 class="text-xl font-semibold text-slate-950">Sharing and retention</h2><p class="mt-2">Information may be processed by service providers used for hosting, email, scheduling, or customer relationship management. We retain enquiries only as long as needed for legitimate business and legal purposes.</p></section>
        <section><h2 class="text-xl font-semibold text-slate-950">Your choices</h2><p class="mt-2">You may ask us to access, correct, or delete your information, subject to applicable law. Contact the Kervox team using the contact details supplied during your engagement.</p></section>
      </div>
    </article>
  </main>
</BaseLayout>
