---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaWithTextMarquee from "@/components/ui/cta-with-text-marquee";
import ClientTestimonials from "@/components/ui/client-testimonials";
import { ProjectShowcase } from "@/components/ui/project-showcase";
import HeroScrollSequence from "@/components/HeroScrollSequence";

const whyItems = [
  { title: "One Customer Journey", description: "Connect marketing, sales, applications, onboarding and ongoing management.", number: "01", image: "/section-images/why-performance.png" },
  { title: "One Operational Platform", description: "Give different departments the tools they need while keeping workflows connected.", number: "02", image: "/section-images/why-scale.png" },
  { title: "One Source of Information", description: "Reduce duplicated records and unnecessary manual data handling.", number: "03", image: "/section-images/why-security.png" },
  { title: "Built Around Your Business", description: "Configure workflows, departments and processes around your operating model.", number: "04", image: "/section-images/why-recovery.png" },
  { title: "One Connected Foundation", description: "One platform instead of disconnected processes.", number: "05", image: "/section-images/why-reliability.png" },
];
---

<BaseLayout title="Kervox | One Platform. Total Control." description="Kervox connects every stage of your business into one operating platform.">
  <main class="min-h-screen bg-background text-foreground">
    <HeroScrollSequence client:load />

    <ProjectShowcase
      client:load
      label="PLATFORM"
      eyebrow="More than a dashboard"
      heading="Everything Your Teams Need. Working Together."
    />

    <ProjectShowcase
      client:load
      id="why"
      label="WHY KERVOX"
      eyebrow="The problem with disconnected systems"
      heading="Your Business Shouldn't Have to Work in Pieces."
      items={whyItems}
    />

    <ClientTestimonials client:load />

    <CtaWithTextMarquee client:load />

    <footer class="bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 text-sm text-slate-600 md:flex-row md:items-center md:justify-between md:px-8">
        <p class="font-semibold text-slate-950">KERVOX</p>
        <nav class="flex flex-wrap gap-x-6 gap-y-3" aria-label="Footer navigation">
          <a class="transition hover:text-sky-700" href="#services">Platform</a>
          <a class="transition hover:text-sky-700" href="#why">Why Kervox</a>
          <a class="transition hover:text-sky-700" href="#contact">Book a Demo</a>
        </nav>
        <p>&copy; 2026 Kervox. All rights reserved.</p>
      </div>
    </footer>
  </main>
</BaseLayout>
