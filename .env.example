# Local static server settings
PORT=4321
DEMO_DATA_DIR=.data
TRUST_PROXY=false

# Live booking on Vercel via Cal.com API v2.
# Create a Kervox event type in Cal.com, connect the host calendar and video platform,
# then add these two values in Vercel Project Settings for Production and Preview.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Compact local price indication. Set the approved monthly starting price in USD.
# Supabase will replace these rounded local-currency estimates with your regional price table.
STARTING_PRICE_ZAR=25000
# Optional currency-per-ZAR overrides, e.g. {"PHP":3.85,"USD":0.054}
LOCALIZATION_RATES_JSON=

# Optional CRM or automation webhook, sent only after a calendar booking succeeds.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# The legacy local demo-request endpoint can send email using Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kervox <demo@your-domain.example>
SALES_NOTIFICATION_EMAIL=
